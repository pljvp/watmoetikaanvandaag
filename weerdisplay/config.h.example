#pragma once
// ============================================================
//  Instellingen. Kopieer dit bestand naar "config.h" en pas het aan.
//  (config.h staat in .gitignore en wordt dus niet gedeeld.)
//  Alleen dit bestand (en secrets.h) pas je aan.
